# Copy thành .env rồi chỉnh theo máy. .env đã được gitignore.

# --- Chạy được ở mọi máy ---
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# Đường dẫn SQLite lưu trajectory + bảng Global ID (M5)
MCT_DB_PATH=data/mct.sqlite3

# --- Chỉ dùng trên máy GPU ---
# CHƯA CHỐT: xem driver NVIDIA thực tế trên máy rồi mới điền.
# DeepStream cực kén cặp driver-CUDA-TensorRT (CLAUDE.md §11).
#   nvidia-smi              -> phiên bản driver + CUDA tối đa hỗ trợ
#   Đối chiếu bảng tương thích trong DeepStream Release Notes rồi pin tag chính xác ở đây.
DEEPSTREAM_IMAGE=nvcr.io/nvidia/deepstream:7.1-triton-multiarch
DEEPSTREAM_VERSION=7.1

# Thư mục chứa .onnx / .engine trên máy GPU (mount vào container)
MODELS_DIR=./models
